DB_HOST=localhost
DB_NAME=hongos_db
DB_USER=root
DB_PASS=

MP_ACCESS_TOKEN=TEST-your-access-token-here
MP_PUBLIC_KEY=TEST-your-public-key-here
# Clave secreta de webhooks (Tus integraciones > tu app > Webhooks > Configurar
# notificaciones > Clave secreta). Con ella se verifica que cada aviso de pago
# venga de Mercado Pago. Vacia = no se valida (solo para desarrollo).
MP_WEBHOOK_SECRET=

APP_URL=http://localhost/hongos
SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# --- Mail ---
# Remitente que ven los clientes.
MAIL_FROM=noreply@kabodhi.com
MAIL_FROM_NAME=KABODHI

# SMTP. Si MAIL_SMTP_HOST queda vacio se usa mail() de PHP y, si tampoco esta
# disponible (por ejemplo en local), el mail se guarda en storage/mails/.
# MAIL_SMTP_SECURE: tls (STARTTLS, puerto 587) | ssl (puerto 465) | none
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=tls
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# Donde llegan el formulario de contacto y el aviso de pedido nuevo.
# Si esta vacio se usa el email configurado en el panel (Ajustes > Configuracion).
CONTACT_EMAIL=

# --- Solo desarrollo ---
# Abre el panel sin pedir login. Ademas del flag, la peticion tiene que venir
# de localhost, asi que prendido en un hosting real no hace nada.
# Dejar en false (o borrar la linea) para produccion.
DEV_ADMIN_SIN_LOGIN=false

# --- Correo Argentino (API MiCorreo) ---
# Credenciales de la API: se piden en https://integracion.correoargentino.com.ar
# y son distintas para test y produccion. El ambiente (test/prod) y el CP de
# origen se eligen desde el panel (Ajustes > Configuracion > Correo Argentino).
MICORREO_USER=
MICORREO_PASSWORD=
# customerId de la cuenta MiCorreo. Si se deja vacio se obtiene con el email y
# la clave de la cuenta MiCorreo (los mismos con los que se entra a la web).
MICORREO_CUSTOMER_ID=
MICORREO_EMAIL=
MICORREO_CLAVE=
# Solo para pruebas locales: reemplaza la URL base de la API (p. ej. un mock).
# MICORREO_BASE_URL=http://127.0.0.1:8081/micorreo/v1
# Solo para pruebas locales: mock de la API de Mercado Pago.
# MP_BASE_URL=http://127.0.0.1:8082
