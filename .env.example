DB_HOST=localhost
DB_NAME=hongos_db
DB_USER=root
DB_PASS=

MP_ACCESS_TOKEN=TEST-your-access-token-here
MP_PUBLIC_KEY=TEST-your-public-key-here

APP_URL=http://localhost/hongos
SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# --- Mail ---
# Remitente que ven los clientes.
MAIL_FROM=noreply@kabodhi.com
MAIL_FROM_NAME=KABODHI

# SMTP. Si MAIL_SMTP_HOST queda vacio se usa mail() de PHP y, si tampoco esta
# disponible (por ejemplo en local), el mail se guarda en storage/mails/.
# MAIL_SMTP_SECURE: tls (STARTTLS, puerto 587) | ssl (puerto 465) | none
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=tls
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# Donde llegan el formulario de contacto y el aviso de pedido nuevo.
# Si esta vacio se usa el email configurado en el panel (Ajustes > Configuracion).
CONTACT_EMAIL=
