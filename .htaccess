DirectoryIndex index.html

# --- Archivos que nunca deben servirse por HTTP ---
# .env tiene credenciales de base y tokens de MercadoPago; database/ tiene los
# dumps con el hash del admin; storage/ guarda mails con datos de clientes.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|log|md)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(database|storage)/ - [F,L]
  RewriteRule (^|/)\.git - [F,L]
</IfModule>
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Sin RewriteBase fijo: Apache toma el directorio donde esta este .htaccess.
  # Asi las mismas reglas sirven en la raiz de un dominio y en un subdirectorio.

  # No reescribir archivos o carpetas existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirigir URLs con .html a URL limpia (preserva query string)
  RewriteRule ^([a-z][a-z0-9-]*)\.html$ $1 [R=301,L,QSA]

  # URLs limpias: /productos -> productos.html
  RewriteRule ^([a-z][a-z0-9-]*)/?$ $1.html [L]
</IfModule>
