DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /hongos/

  # No reescribir archivos o carpetas existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirigir URLs con .html a URL limpia (preserva query string)
  RewriteRule ^([a-z][a-z0-9-]*)\.html$ /hongos/$1 [R=301,L,QSA]

  # URLs limpias: /productos → productos.html
  RewriteRule ^([a-z][a-z0-9-]*)/?$ $1.html [L]
</IfModule>
